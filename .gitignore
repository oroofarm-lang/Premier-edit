# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# prisma
/lib/generated/prisma
/prisma/dev.db
/prisma/dev.db-journal

# Obsidian vault local config (personal editor state, not project code)
/Volt/.obsidian/

# Claude Code local settings (personal, not shared with the team)
/.claude/settings.local.json

# Python venv for local transcription (recreate with scripts/setup-transcription.sh)
/.venv

# Downloaded Whisper model weights — large, fetched on first run
/models

# Exported timelines (generated artifacts)
/exports

# Generated test media (TTS Hebrew samples — regenerable, not source)
/test-media

# Git worktrees used for isolated feature work (superpowers:using-git-worktrees)
/.worktrees

# Real Adobe Premiere Pro project data, not project source — appears at the
# repo root when Premiere is opened/tested from this folder (e.g. Stage 2
# panel verification). Never intentional project content.
/Adobe Premiere Pro Auto-Save/
/*.prproj

# Scratch copy of the panel served over HTTP for verification (npm run panel:preview)
public/_panel

# Briefs and scripts written for the script-writing agents; regenerable.
scripts-out/
